PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=resumely
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
GEMINI_API_KEY=your-gemini-api-key-here
# Low-cost model by default; fast enough for scoring and the job writer.
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order after 3 attempts on GEMINI_MODEL fail with 429/503 (comma separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash

# ---------------------------------------------------------------------------
# Optional. Everything works without these; uncomment only when you need them.
# ---------------------------------------------------------------------------

# Cloudinary (all three needed): stores logos and original resume files.
# Without it, logos are kept in MongoDB and only the resume text is stored.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Real emails. Without SMTP_HOST, emails are printed to the server console.
# Gmail: smtp.gmail.com / 587 with an App Password. Brevo: smtp-relay.brevo.com / 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Resumely <no-reply@yourdomain.com>

# Payments (Razorpay). Without keys: "demo upgrade" outside production, upgrades disabled in production.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Set when deploying (defaults: http://localhost:3000 and Asia/Kolkata).
# APP_URL=https://your-domain.com
# APP_TIMEZONE=Asia/Kolkata

# Tuning
# SCORING_CONCURRENCY=2   # parallel AI scoring jobs for applications
# API_RATE_LIMIT=600      # requests per signed-in user (or per IP when signed out) per 15 minutes
# AI_RATE_LIMIT=30        # AI checks per user per hour

# Demo data (no env needed):
#   npm run seed:jobs                         -> demo companies, employees, jobs, referrals
#   npm run seed:company -- you@company.com   -> adds demo data to your own employer account
