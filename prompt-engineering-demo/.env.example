# Option A: Gemini Developer API (free tier = 20 requests/day/model)
GEMINI_API_KEY=

# Option B: Vertex AI Express Mode (higher quota, no GCP project/ADC needed)
# If both keys are set, Vertex is used automatically. Force one explicitly
# with LLM_BACKEND=gemini or LLM_BACKEND=vertex.
VERTEX_API_KEY=
# LLM_BACKEND=vertex

GEMINI_MODEL=gemini-2.5-flash
